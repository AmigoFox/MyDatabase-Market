<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CrossApp.LoginPage"
             Title="LoginPage"
             BackgroundColor="#F0F0F0">

    <ScrollView>
        <VerticalStackLayout Padding="40" Spacing="20" HorizontalOptions="Center">

            <Label Text="&#128100; Вход в систему" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="#4A148C" 
                   HorizontalOptions="Center"/>

            <Entry x:Name="LoginEntry"
                   Placeholder="Логин"
                   BackgroundColor="White"
                   TextColor="Black"
                   FontSize="16"
                   PlaceholderColor="#9E9E9E"

                   HeightRequest="50"
                   HorizontalOptions="Fill"/>

            <Entry x:Name="PasswordEntry"
                   Placeholder="Пароль"
                   IsPassword="True"
                   BackgroundColor="White"
                   TextColor="Black"
                   FontSize="16"
                   PlaceholderColor="#9E9E9E"

                   HeightRequest="50"
                   HorizontalOptions="Fill"/>

            <Button Text="&#128274; Войти"
                    BackgroundColor="#5C6BC0"
                    TextColor="White"
                    CornerRadius="15"
                    HeightRequest="50"
                    FontSize="18"
                    FontAttributes="Bold"
                    Clicked="OnLoginClicked"
                    HorizontalOptions="Fill"
                    Margin="0,10,0,0"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
