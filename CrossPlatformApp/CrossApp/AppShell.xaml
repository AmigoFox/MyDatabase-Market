<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CrossApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CrossApp"
    Title="CrossApp">

    <!-- 🔐 АККАУНТ -->
    <FlyoutItem Title="🔐 Аккаунт">
        <ShellContent
            Title="Вход / регистрация"
            ContentTemplate="{DataTemplate local:LoginPage}"
            Route="LoginPage" />
    </FlyoutItem>

    <!-- 🏠 ОСНОВНОЕ -->
    <FlyoutItem Title="🏠 Основное">

        <ShellContent
            Title="Обзор"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />

        <ShellContent
            Title="➕ Создать заказ"
            ContentTemplate="{DataTemplate local:DatabaseCalculator}"
            Route="DatabaseCalculator" />

        <ShellContent
            Title="📦 Заказы"
            ContentTemplate="{DataTemplate local:OrdersPage}"
            Route="OrdersPage" />

    </FlyoutItem>


    <!-- 💳 ФИНАНСЫ -->
    <FlyoutItem Title="💳 Финансы">
        <ShellContent
            Title="Платежи"
            ContentTemplate="{DataTemplate local:PaymentsPage}"
            Route="PaymentsPage" />
    </FlyoutItem>


    <!-- 👤 ПРОФИЛЬ -->
    <FlyoutItem Title="👤 Профиль">

        <ShellContent
            Title="Личный кабинет"
            ContentTemplate="{DataTemplate local:ProfilePage}"
            Route="ProfilePage" />

        <ShellContent
            Title="Настройки"
            ContentTemplate="{DataTemplate local:SettingsPage}"
            Route="SettingsPage" />

    </FlyoutItem>

</Shell>