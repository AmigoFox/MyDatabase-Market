using System.Net.Http;
using System.Net.Http.Headers;
using System.Threading;
using System.Threading.Tasks;
using System.Diagnostics;


namespace CrossApp.Services.Api
{
    public class AuthHandler : DelegatingHandler
    {
        private readonly AuthTokenStore _tokenStore;

        public AuthHandler(AuthTokenStore tokenStore)
        {
            _tokenStore = tokenStore;
        }

        protected override async Task<HttpResponseMessage> SendAsync(
            HttpRequestMessage request,
            CancellationToken cancellationToken)
        {
            var token = _tokenStore.GetToken();

            // diagnostic logging (mask token)
            if (!string.IsNullOrWhiteSpace(token))
            {
                var masked = token.Length > 10 ? token.Substring(0, 10) + "..." : token;
                Debug.WriteLine($"AuthHandler: attaching token '{masked}' to {request.Method} {request.RequestUri}");

                request.Headers.Authorization =
                    new AuthenticationHeaderValue("Bearer", token);
            }
            else
            {
                Debug.WriteLine($"AuthHandler: no token for request {request.Method} {request.RequestUri}");
            }

            return await base.SendAsync(request, cancellationToken);
        }
    }
}