<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CrossApp.OrderDetailsPage"
             Title="Детали заказа"
             BackgroundColor="#F8F4FF">

    <ScrollView>

        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Заголовок -->
            <Label Text="Информация о заказе"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="#4A148C"/>

            <Frame BackgroundColor="White"
                   BorderColor="#D1C4E9"
                   CornerRadius="16"
                   Padding="16">

                <VerticalStackLayout Spacing="10">

                    <Label Text="{Binding Order.DatabaseType, TargetNullValue=''}"/>
                    <Label Text="{Binding Order.SizeGB, TargetNullValue=''}"/>
                    <Label Text="{Binding Order.Iops, TargetNullValue=''}"/>
                    <Label Text="{Binding CountriesText}"/>
                    <Label Text="{Binding Order.FinalPriceRub, TargetNullValue=''}"/>

                </VerticalStackLayout>

            </Frame>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>