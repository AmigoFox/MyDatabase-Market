<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CrossApp.ProfilePage"
             Title="Личный кабинет"
             BackgroundColor="#F8F4FF">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Заголовок -->
            <Label Text="Личный кабинет"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#4A148C" />

            <!-- ✅ Блок информации о пользователе -->
            <Frame BackgroundColor="White"
                   BorderColor="#D1C4E9"
                   CornerRadius="12"
                   Padding="16"
                   Margin="0,0,0,12">

                <VerticalStackLayout Spacing="6">

                    <Label Text="Информация аккаунта"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#6A1B9A" />

                    <Label Text="Имя: Андрей"
                           FontSize="14"
                           TextColor="#4A148C" />

                    <Label Text="Почта: andr***@gmail.com"
                           FontSize="14"
                           TextColor="#4A148C" />

                    <Label Text="Дата регистрации: 12.03.2024"
                           FontSize="14"
                           TextColor="#4A148C" />

                    <Label Text="Активных подписок: 2"
                           FontSize="14"
                           TextColor="#4A148C" />

                    <Label Text="ID аккаунта: #DBM-00421"
                           FontSize="14"
                           TextColor="#4A148C" />

                </VerticalStackLayout>
            </Frame>


        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
